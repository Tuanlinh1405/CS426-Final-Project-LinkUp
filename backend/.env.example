# Copy to backend/.env; never commit real credentials.
PORT=8080
LINKUP_SERVER_HOST=0.0.0.0

# Use the existing database connection supplied by the backend/database owner.
# Percent-encode reserved characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Use the JWT settings supplied by the backend owner, not a Supabase API key.
JWT_SECRET=
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=linkup

# Reserved for the future media service; not required for DB/auth setup.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=linkup

# Reels media storage: minio (default) or local for a single-machine development server.
# Database still uses DATABASE_URL in either mode. Never put video files in PostgreSQL.
REELS_STORAGE=minio
# Optional local directory, relative to the .env folder or an absolute path:
# REELS_LOCAL_DIR=.reels-media

# Supabase Storage credentials belong in backend/.env.storage (see .env.storage.example).
